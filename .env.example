# The Postgres the test suite runs against. Copy to `.env` (gitignored); `pnpm test`
# loads it. A Postgres suite fails, never skips, when these are missing.
#
# The role needs CREATE on the database, not only on its `public` schema: every
# Postgres test case creates a schema of its own and drops it afterwards. Owning the
# database is enough; otherwise, as a superuser:
#   GRANT CREATE ON DATABASE <database> TO <user>;
TEST_PG_HOST=localhost
TEST_PG_PORT=5432
TEST_PG_DATABASE=
TEST_PG_USER=
TEST_PG_PASSWORD=
